    "gate:test": "node scripts/gate.mjs vitest -- node node_modules/vitest/vitest.mjs run --pool=forks --maxWorkers=1",
    "smoke": "node scripts/smoke.mjs",
    "test:urls": "tsx scripts/test-urls.ts",
    "eval:chat": "tsx scripts/call-cron.ts eval-chat",
    "cron": "tsx scripts/call-cron.ts",
    "media:import": "tsx scripts/media-import.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
