# Copy to .env.local for local development. Every service is optional locally:
# leave a value empty and the app uses its local stand-in.

# --- Database -----------------------------------------------------------------
# Empty DATABASE_URL = embedded PGlite (Postgres in WASM) stored in PGLITE_DIR.
# Production: Neon (Vercel Marketplace). Pooled URL for the app, direct URL for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
PGLITE_DIR=.data/pglite

# --- File storage ---------------------------------------------------------------
# Empty token = files stored in LOCAL_BLOB_DIR and served from /blob/.
BLOB_READ_WRITE_TOKEN=
# Use private when the store requires authenticated reads; catalogue images are streamed through /blob/.
BLOB_ACCESS=public
# Optional override of the public Blob base URL (derived from the token otherwise).
BLOB_BASE_URL=
LOCAL_BLOB_DIR=.data/blob

# --- Admin sign-in (Auth.js) -------------------------------------------------------
AUTH_SECRET=replace-with-a-long-random-string
# The first owner account is created from these on the first seed, never overwritten.
OWNER_EMAIL=owner@sofafactoryoutlet.lk
OWNER_PASSWORD=replace-before-first-run
OWNER_NAME=Owner

# --- Chatbot (OpenRouter) -----------------------------------------------------------
# Empty key = template-only mode (FAQs, product search, pairings, store info still work).
OPENROUTER_API_KEY=
# Fallback order; admin settings can override. Re-test against the golden set before changing.
OPENROUTER_CHAT_MODELS=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3.5-lightning:free
# Month 3: e.g. nvidia/nemotron-3.5-embed-1b:free — then "Turn on embeddings" in admin settings.
OPENROUTER_EMBED_MODEL=

# --- Email (optional, Resend) -------------------------------------------------------
RESEND_API_KEY=
ADMIN_ALERT_EMAIL=
EMAIL_FROM=Sofa Factory Outlet <bookings@sofafactoryoutlet.lk>

# --- Scheduled jobs ----------------------------------------------------------------
# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>"; local scripts use the same header.
CRON_SECRET=replace-with-a-random-string

# --- Site ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Search (optional) ---------------------------------------------------------------
INDEXNOW_KEY=
# Base64 of a Google service-account JSON with Search Console read access.
GSC_SERVICE_ACCOUNT_JSON=
GSC_SITE_URL=sc-domain:sofafactoryoutlet.lk
